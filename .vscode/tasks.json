{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build BCSRec",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${workspaceFolder}/BCSRec/main.c",
                "${workspaceFolder}/BCSRec/functions.c",
                "-o",
                "${workspaceFolder}/BCSRec/BCSRec"
            ],
            "options": {
                "cwd": "${workspaceFolder}/BCSRec"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}